{
  "name": "@analyze-music/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-preload.mjs",
    "dev": "pnpm run build && electron dist/main.js",
    "lint": "eslint src tests --max-warnings=0",
    "pack": "pnpm run build && electron-builder --dir",
    "prepare-runtime": "node scripts/prepare-runtime.mjs",
    "start": "electron dist/main.js",
    "test": "vitest run",
    "test:electron": "pnpm run pack && playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.2.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.analyzemusic.desktop",
    "beforePack": "./scripts/before-pack.cjs",
    "disableDefaultIgnoredFiles": true,
    "productName": "Analyze Music",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "runtime/admin",
        "to": "admin"
      },
      {
        "from": "runtime/node-service",
        "to": "node-service"
      },
      {
        "from": "runtime/default.env",
        "to": "default.env"
      },
      {
        "from": "runtime/tools",
        "to": "tools"
      },
      {
        "from": "runtime/dependencies",
        "to": "dependencies"
      }
    ],
    "files": [
      "dist/**"
    ]
  }
}
