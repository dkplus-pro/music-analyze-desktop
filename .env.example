# Copy this file to .env and set a DashScope / Bailian API key before starting the API.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.5-omni-plus
# Optional: use this only when `bl` is not on PATH but has an authenticated profile.
BAILIAN_CLI_PATH=bl
# Optional: override the Python command used by the deterministic feature extractor.
MUSIC_ANALYZER_PYTHON=python3
# Optional Feishu Bitable: APP_ID and APP_SECRET enable “创建飞书库”; APP_TOKEN and TABLE_ID connect an existing library.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=
DATABASE_URL=file:data/analyze-music.db
MUSIC_STORAGE_PATH=data/music
PORT=3001
